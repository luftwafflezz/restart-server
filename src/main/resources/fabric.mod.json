{
  "schemaVersion": 1,
  "id": "restart-server",
  "version": "${version}",
  "name": "Restart Server",
  "description": "Adds a restart command to dedicated servers.",
  "authors": [
    "Steveplays28",
    "luftwafflezz"
  ],
  "contact": {
    "homepage": "https://github.com/luftwafflezz/restart-server",
    "sources": "https://github.com/luftwafflezz/restart-server",
    "issues": "https://github.com/luftwafflezz/restart-server/issues"
  },
  "license": "LGPLv2.1",
  "icon": "assets/restart-server/icon.png",
  "environment": "server",
  "entrypoints": {
    "server": [
      "io.github.luftwafflezz.restartserver.RestartServer"
    ]
  },
  "mixins": [
    {
      "config": "restart-server.mixins.json",
      "environment": "server"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "cloth-config": ">=26.3"
  }
}
